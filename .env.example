# Agent Games HMAC secret — DO NOT commit a real value here.
# The platform generates a 32-byte random secret at agent registration
# and shows it EXACTLY ONCE. Paste it here only on the deploy host
# (Railway/Vercel env vars), never into git.
AGENT_GAMES_HMAC_SECRET=

# Port the server listens on (hosting provides PORT; default 3000 locally)
PORT=3000

# Set to "true" only after the circuit signal names have been verified
# against the downloaded gatekeeper.wasm (see proof.js / circuits/README.md).
# When false, the server still decides correctly but returns proof: null
# (a correct decision without a valid proof costs an extra -2 and no
# reliability bonus, per the official score model).
PROOF_ENABLED=false
